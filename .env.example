# Leave empty until the actual C# / WMS service is available. No demo fallback.
# API base is the origin / deployment prefix, WITHOUT /api/wms-fg/map.
VITE_WMS_API_BASE=
# Optional explicit layout for an empty local workspace. Existing local identity must match.
VITE_WMS_LAYOUT_CODE=
# Explicit WMS warehouse scope, not inferred from FG01 / FG02 rack ownership.
VITE_WMS_WAREHOUSE_CODE=
# Full SignalR Hub URL agreed with the backend; no assumed production route.
VITE_WMS_HUB_URL=

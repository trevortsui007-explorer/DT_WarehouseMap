{
  "name": "warehouse-map-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/check-model.mjs && node scripts/check-spatial.mjs && node scripts/check-cad.mjs && node scripts/check-doors.mjs && node scripts/check-layout-store.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.js *.json index.html",
    "format:check": "prettier --check src tests scripts *.js *.json index.html"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "dexie": "^4.0.0",
    "fflate": "^0.8.3",
    "konva": "10.6.0",
    "three": "0.180.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
